[Application]
ConfigVersion=8
Theme=System
CloseToTray=true
StartMinimized=false
StartWithWindows=false
StartHiddenWhenAutoStarted=true
AutoStartScripts=true
ConfirmBeforeDelete=true
MainWindowPlacementSaved=false
MainWindowX=0
MainWindowY=0
MainWindowWidth=1120
MainWindowHeight=680
MainWindowMaximized=false
EditorPath=%SystemRoot%\System32\notepad.exe
EditorArguments="{file}"
LogLevel=Information
LogRetentionDays=14
LogScriptOutput=false
ConsoleFontName=Consolas
ConsoleFontSize=10
ConsolePaneHeight=235
ConsoleForegroundColor=#DCDCDC
ConsoleBackgroundColor=#1C1C1C
ConsoleBackgroundOpacity=100
ConsoleTabForegroundColor=#262B32
ConsoleActiveTabForegroundColor=#F5F7FA
ConsoleTabBackgroundColor=#FCFCFD
ConsoleTabBackgroundOpacity=100
ConsoleActiveTabBackgroundColor=#1C1C1C
ConsoleActiveTabBackgroundOpacity=100

[Defaults]
Interpreter=Auto
Arguments=
WorkingDirectory=
WindowMode=Hidden
CaptureOutput=true
OutputEncoding=Auto
WordWrap=false
AllowParallelInstances=false
StopPolicy=GracefulThenKill
StopTimeoutSeconds=5

[PowerShell]
PowerShell7Path=

[Localization]
Language=ru

